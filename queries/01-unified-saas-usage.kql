// =========================================================================
// 01-unified-saas-usage.kql
// Purpose : Unified SaaS usage model using Defender Advanced Hunting tables.
//           Returns one row per user+application with classification and
//           IdentityInfo-enriched attributes.
//
// Tables  : CloudAppEvents, EntraIdSignInEvents, IdentityLogonEvents,
//           IdentityInfo
// Does NOT use: McasShadowItReporting, SigninLogs, AADSignInEventsBeta
//
// Classification priority:
//   1 – Verified Activity  : CloudAppEvents has an action for this user+app
//   2 – Verified Sign-In   : EntraIdSignInEvents (ErrorCode=0) or
//                            IdentityLogonEvents (LogonSuccess)
//   3 – Unknown            : No evidence in the selected time range
// =========================================================================

let StartTime = ago(90d);  // adjust or replace with workbook parameter
let EndTime   = now();

// ── User enrichment: most recent IdentityInfo snapshot per account ────────
// Optional: if IdentityInfo doesn't exist or has missing columns, returns empty
// table with correct schema so joins don't fail.
let UserInfo = 
    union isfuzzy=true
    (IdentityInfo
     | summarize arg_max(column_ifexists('TimeGenerated', now()), *) by column_ifexists('AccountUpn', '')
     | project
         EmailAddress = tolower(tostring(column_ifexists('AccountUpn', ''))),
         DisplayName  = tostring(column_ifexists('AccountDisplayName', '')),
         Department   = tostring(column_ifexists('Department', '')),
         Country      = tostring(column_ifexists('Country', ''))),
    (datatable(EmailAddress: string, DisplayName: string, Department: string, Country: string)[])

// ── Combine, classify, enrich ─────────────────────────────────────────────
// Each branch is inlined so isfuzzy=true can skip any table that doesn't exist
// in the current workspace without failing the whole query.
union isfuzzy=true
    // Priority 1: Verified Activity (CloudAppEvents)
    (CloudAppEvents
     | where Timestamp between (StartTime..EndTime)
     | where isnotempty(Application)
     | extend EmailAddress = tolower(tostring(coalesce(
           column_ifexists('AccountUpn', ''),
           iff(isnotempty(column_ifexists('AccountName', '')) and isnotempty(column_ifexists('AccountDomain', '')),
               strcat(column_ifexists('AccountName', ''), '@', column_ifexists('AccountDomain', '')), ''))))
     | where isnotempty(EmailAddress) and EmailAddress != '@'
     | project Timestamp, Application, EmailAddress,
               DisplayName = tostring(column_ifexists('AccountDisplayName', '')),
               ActionType  = tostring(column_ifexists('ActionType', '')),
               Evidence    = 'Verified Activity'),
    // Priority 2: Verified Sign-In (EntraIdSignInEvents)
    (EntraIdSignInEvents
     | where Timestamp between (StartTime..EndTime)
     | where isnotempty(Application) and isnotempty(column_ifexists('AccountUpn', ''))
     | where column_ifexists('ErrorCode', -1) == 0   // 0 = successful authentication
     | project Timestamp, Application,
               EmailAddress = tolower(tostring(column_ifexists('AccountUpn', ''))),
               DisplayName  = tostring(column_ifexists('AccountDisplayName', '')),
               ActionType   = 'SignInSuccess',
               Evidence     = 'Verified Sign-In'),
    // Priority 2 fallback: Verified Sign-In (IdentityLogonEvents)
    // Note: Application may be empty for cloud-only SaaS.
    (IdentityLogonEvents
     | where Timestamp between (StartTime..EndTime)
     | where column_ifexists('ActionType', '') == 'LogonSuccess'
     | where isnotempty(Application) and isnotempty(column_ifexists('AccountUpn', ''))
     | project Timestamp, Application,
               EmailAddress = tolower(tostring(column_ifexists('AccountUpn', ''))),
               DisplayName  = tostring(column_ifexists('AccountDisplayName', '')),
               ActionType   = tostring(column_ifexists('ActionType', '')),
               Evidence     = 'Verified Sign-In')
| summarize
    LastActive      = max(Timestamp),
    TotalDaysUsed   = dcount(startofday(Timestamp)),
    HasAppActivity  = max(iff(Evidence == 'Verified Activity', 1, 0)),
    HasSignIn       = max(iff(Evidence == 'Verified Sign-In', 1, 0)),
    EvidenceSources = make_set(Evidence, 5),
    SampleActions   = make_set(ActionType, 5),
    AnyDisplayName  = take_any(DisplayName)
    by Application, EmailAddress
| extend
    UsageClassification = case(
        HasAppActivity == 1, 'Verified Activity',
        HasSignIn == 1,      'Verified Sign-In',
                             'Unknown'),
    ActivityStatus = case(
        isnull(LastActive),     'Unknown',
        LastActive >= ago(30d), 'Active 30d',
        LastActive >= ago(90d), 'Active 90d',
        LastActive < ago(90d),  'Inactive >90d',
        'Unknown')
| join kind=leftouter UserInfo on EmailAddress
| extend
    DisplayName = coalesce(DisplayName1, AnyDisplayName),
    Department  = coalesce(Department1, ''),
    Country     = coalesce(Country1, '')
| project
    Application,
    EmailAddress,
    DisplayName,
    Department,
    Country,
    UsageClassification,
    ActivityStatus,
    LastActive,
    TotalDaysUsed,
    EvidenceSources = tostring(EvidenceSources),
    SampleActions   = tostring(SampleActions)
| order by LastActive desc
