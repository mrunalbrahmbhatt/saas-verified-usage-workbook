// =========================================================================
// Microsoft Sentinel Identity & Access Dashboard - KQL Queries Reference
// =========================================================================
// All KQL queries used in the workbook with detailed explanations
// These queries work with Microsoft Sentinel SigninLogs table
// =========================================================================

// ─────────────────────────────────────────────────────────────────────────
// SECTION 1: EXECUTIVE SUMMARY – KPIs
// ─────────────────────────────────────────────────────────────────────────

// KPI 1: Total Users
// Counts distinct users who have signed in during the selected time range
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| summarize TotalUsers = dcount(UserPrincipalName)

// KPI 2: Total Applications
// Counts distinct applications accessed during the selected time range
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| summarize TotalApplications = dcount(AppDisplayName)

// KPI 3: Successful Sign-ins
// Counts sign-ins where ResultType == 0 (success)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ResultType == 0
| summarize SuccessfulSignins = count()

// KPI 4: Failed Sign-ins
// Counts sign-ins where ResultType != 0 (any failure)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ResultType != 0
| summarize FailedSignins = count()

// KPI 5: Applications Without Conditional Access Protection
// Identifies unique applications accessed without CA protection
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend CAStatus = iff(ConditionalAccessStatus == "success", "Protected", "Unprotected")
| where CAStatus == "Unprotected"
| summarize UnprotectedApps = dcount(AppDisplayName)

// ─────────────────────────────────────────────────────────────────────────
// SECTION 2: APPLICATION ACCESS MATRIX
// ─────────────────────────────────────────────────────────────────────────

// Application metrics by CA status
// Returns: App, CA Status, User Count, Success/Failure counts, MFA percentage
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend CAStatus = iff(ConditionalAccessStatus == "success", "Protected", "Unprotected")
| extend MFAUsed = iff(column_ifexists('AuthenticationRequirement', '') == 'MFA', 1, 0)
| summarize
    Users = dcount(UserPrincipalName),
    Success = countif(ResultType == 0),
    Failed = countif(ResultType != 0),
    MFAPercent = round(sum(MFAUsed) * 100.0 / count(), 1)
    by AppDisplayName, CAStatus
| order by Success desc

// ─────────────────────────────────────────────────────────────────────────
// SECTION 3: APPLICATIONS WITHOUT PROTECTION (HIGH RISK)
// ─────────────────────────────────────────────────────────────────────────

// Unprotected application access attempts
// Returns: Time, Application, User, IP, Location, Auth Method, Result
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ConditionalAccessStatus != "success"
| project
    TimeGenerated,
    Application = AppDisplayName,
    User = UserPrincipalName,
    IPAddress,
    Location = column_ifexists('Location', 'N/A'),
    AuthMethod = column_ifexists('AuthenticationMethodsUsed', 'Unknown'),
    Result = iff(ResultType == 0, "Success", "Failed")
| order by TimeGenerated desc

// ─────────────────────────────────────────────────────────────────────────
// SECTION 4: USER INVESTIGATION
// ─────────────────────────────────────────────────────────────────────────

// User sign-in summary (total signins, unique apps, failure count, last signin)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where UserPrincipalName == "{User}" or "{User}" == "All"
| summarize
    SigninCount = count(),
    UniqueApps = dcount(AppDisplayName),
    UniqueIPs = dcount(IPAddress),
    FailureCount = countif(ResultType != 0),
    LastSignin = max(TimeGenerated)
    by UserPrincipalName
| order by SigninCount desc

// User recent sign-ins (detailed activity log)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where UserPrincipalName == "{User}" or "{User}" == "All"
| project
    TimeGenerated,
    Application = AppDisplayName,
    Result = iff(ResultType == 0, "Success", "Failed"),
    IPAddress,
    Device = DeviceName,
    Location = column_ifexists('Location', 'N/A'),
    AuthMethod = column_ifexists('AuthenticationMethodsUsed', 'Unknown')
| order by TimeGenerated desc

// ─────────────────────────────────────────────────────────────────────────
// SECTION 5: AUTHENTICATION ANALYSIS
// ─────────────────────────────────────────────────────────────────────────

// MFA vs Non-MFA breakdown (pie chart)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend MFARequired = column_ifexists('AuthenticationRequirement', 'Unknown')
| summarize Count = count() by MFARequired
| order by Count desc

// Authentication methods used (expanded from nested JSON)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| mv-expand AuthenticationDetailsArray = parse_json(column_ifexists('AuthenticationDetails', '[]'))
| extend AuthMethod = tostring(AuthenticationDetailsArray.authenticationMethod)
| where isnotempty(AuthMethod)
| summarize Count = count() by AuthMethod
| order by Count desc

// ─────────────────────────────────────────────────────────────────────────
// SECTION 6: CONDITIONAL ACCESS COVERAGE
// ─────────────────────────────────────────────────────────────────────────

// CA protection percentage and metrics
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| summarize
    Protected = countif(ConditionalAccessStatus == "success"),
    Unprotected = countif(ConditionalAccessStatus != "success")
| extend Total = Protected + Unprotected
| extend ProtectionPercent = round(Protected * 100.0 / Total, 1)

// ─────────────────────────────────────────────────────────────────────────
// SECTION 7: USER ACTIVITY TIMELINE
// ─────────────────────────────────────────────────────────────────────────

// Complete timeline of sign-in events (last 1000 records)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| project
    TimeGenerated,
    User = UserPrincipalName,
    Application = AppDisplayName,
    Result = iff(ResultType == 0, "Success", "Failed"),
    IPAddress,
    Description = ResultDescription
| order by TimeGenerated desc
| limit 1000

// ─────────────────────────────────────────────────────────────────────────
// SECTION 8: GEOGRAPHIC ACCESS MAP
// ─────────────────────────────────────────────────────────────────────────

// Sign-in activity aggregated by location
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| summarize
    Count = count(),
    Users = dcount(UserPrincipalName),
    Failures = countif(ResultType != 0)
    by Location

// ─────────────────────────────────────────────────────────────────────────
// SECTION 9: RISK CORRELATION
// ─────────────────────────────────────────────────────────────────────────

// Risk level classification (High = Failed, Medium = Unprotected, Low = Success+Protected)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend RiskLevel = case(
    ResultType != 0, "High",
    ConditionalAccessStatus != "success", "Medium",
    "Low")
| summarize
    Count = count(),
    UniqueUsers = dcount(UserPrincipalName),
    FailureRate = round(countif(ResultType != 0) * 100.0 / count(), 1)
    by RiskLevel
| order by Count desc

// Failed sign-in root cause analysis
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ResultType != 0
| summarize
    FailureCount = count(),
    UniqueUsers = dcount(UserPrincipalName),
    UniqueApps = dcount(AppDisplayName)
    by ResultType, ResultDescription
| order by FailureCount desc

// ─────────────────────────────────────────────────────────────────────────
// SECTION 10: APPLICATION DEEP DIVE
// ─────────────────────────────────────────────────────────────────────────

// Application overview with success and protection rates
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where AppDisplayName == "{Application}" or "{Application}" == "All"
| summarize
    TotalSignins = count(),
    UniqueUsers = dcount(UserPrincipalName),
    SuccessCount = countif(ResultType == 0),
    FailureCount = countif(ResultType != 0),
    ProtectedCount = countif(ConditionalAccessStatus == "success")
    by AppDisplayName
| extend SuccessRate = round(SuccessCount * 100.0 / TotalSignins, 1)
| extend ProtectionRate = round(ProtectedCount * 100.0 / TotalSignins, 1)

// Top users accessing a specific application
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where AppDisplayName == "{Application}" or "{Application}" == "All"
| summarize Count = count() by UserPrincipalName
| top 20 by Count desc

// Recent failures for a specific application
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where AppDisplayName == "{Application}" or "{Application}" == "All"
| where ResultType != 0
| project
    TimeGenerated,
    User = UserPrincipalName,
    Application = AppDisplayName,
    ResultDescription,
    IPAddress,
    Location = column_ifexists('Location', 'N/A')
| order by TimeGenerated desc

// ─────────────────────────────────────────────────────────────────────────
// OPTIONAL ADVANCED QUERIES FOR EXTENSIONS
// ─────────────────────────────────────────────────────────────────────────

// Identify potential credential spray attacks (multiple users, same app, failures)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ResultType != 0
| summarize
    UniqueUsers = dcount(UserPrincipalName),
    FailureCount = count(),
    TimeRange = max(TimeGenerated) - min(TimeGenerated)
    by AppDisplayName
| where UniqueUsers > 5 and FailureCount > 20
| order by FailureCount desc

// Identify anomalous sign-in activity (unusual time, location, or device)
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| where ResultType == 0
| extend Hour = floor(TimeGenerated / 1h) * 1h
| summarize
    SigninCount = count(),
    UniqueLocations = dcount(Location),
    UniqueDevices = dcount(DeviceName)
    by UserPrincipalName, Hour
| where UniqueLocations > 2 or UniqueDevices > 3
| order by SigninCount desc

// MFA adoption by user
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend MFAUsed = iff(column_ifexists('AuthenticationRequirement', '') == 'MFA', 1, 0)
| summarize
    TotalSignins = count(),
    MFASignins = sum(MFAUsed),
    MFAPercent = round(sum(MFAUsed) * 100.0 / count(), 1)
    by UserPrincipalName
| order by MFAPercent desc

// Conditional Access policy effectiveness
SigninLogs
| where TimeGenerated >= ago({TimeRange})
| extend CAStatus = iff(ConditionalAccessStatus == "success", "Protected", "Unprotected")
| summarize
    TotalSignins = count(),
    Protected = countif(CAStatus == "Protected"),
    SuccessRate = round(countif(ResultType == 0) * 100.0 / count(), 1)
    by CAStatus
| order by Protected desc

// ─────────────────────────────────────────────────────────────────────────
// NOTES FOR KQL OPTIMIZATION
// ─────────────────────────────────────────────────────────────────────────
// 1. All queries use column_ifexists() for optional fields to ensure compatibility
// 2. Time range is parameterized using {TimeRange} placeholder
// 3. User and Application filters support "All" value for unrestricted queries
// 4. ResultType == 0 indicates successful authentication, != 0 indicates failure
// 5. ConditionalAccessStatus == "success" indicates CA policy was applied
// 6. Use mv-expand carefully on large datasets; consider limiting with where clauses first
// 7. For performance, filter on TimeGenerated early in the query pipeline
// 8. Consider retention policy: default is 30 days, can extend to 90+ days
// ─────────────────────────────────────────────────────────────────────────
