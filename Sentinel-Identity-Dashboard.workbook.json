{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Microsoft Sentinel Identity & Access Dashboard\n\n**Real-time visibility** into user access patterns, authentication methods, and Conditional Access protection across your enterprise."
      },
      "name": "header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "name": "Workspace",
            "version": "KqlParameterItem/1.0",
            "label": "Workspace",
            "type": 5,
            "isRequired": true,
            "multiSelect": false,
            "quote": "'",
            "delimiter": ",",
            "query": "resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id, name\n| order by name asc",
            "crossComponentResources": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "value": null
          },
          {
            "name": "TimeRange",
            "label": "Time Range",
            "type": 4,
            "description": "Select the time range for analysis",
            "value": {
              "durationMs": 604800000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 86400000,
                  "displayText": "Last 24 Hours"
                },
                {
                  "durationMs": 604800000,
                  "displayText": "Last 7 Days"
                },
                {
                  "durationMs": 2592000000,
                  "displayText": "Last 30 Days"
                }
              ],
              "allowCustom": true
            },
            "isHiddenWhenLocked": false
          },
          {
            "name": "User",
            "label": "User (Optional)",
            "type": 2,
            "description": "Select a specific user for investigation",
            "multiSelect": false,
            "quote": "'",
            "delimiter": ",",
            "query": "SigninLogs\n| distinct UserPrincipalName\n| order by UserPrincipalName asc",
            "value": null,
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ]
            },
            "crossComponentResources": [
              "{Workspace}"
            ]
          },
          {
            "name": "Application",
            "label": "Application (Optional)",
            "type": 2,
            "description": "Select a specific application",
            "multiSelect": false,
            "quote": "'",
            "delimiter": ",",
            "query": "SigninLogs\n| distinct AppDisplayName\n| order by AppDisplayName asc",
            "value": null,
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ]
            },
            "crossComponentResources": [
              "{Workspace}"
            ]
          },
          {
            "name": "ConditionalAccess",
            "label": "Conditional Access Status",
            "type": 2,
            "value": "All",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\"All\", \"Applied\", \"Not Applied\"]"
          },
          {
            "name": "AuthStatus",
            "label": "Authentication Status",
            "type": 2,
            "value": "All",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[\"All\", \"Success\", \"Failure\"]"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 1 – Executive Summary",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| summarize TotalUsers = dcount(UserPrincipalName)",
              "size": 4,
              "title": "Total Users",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "TotalUsers",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "TotalUsers",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                }
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "total-users"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| summarize TotalApplications = dcount(AppDisplayName)",
              "size": 4,
              "title": "Total Applications",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "TotalApplications",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "TotalApplications",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                }
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "total-apps"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where ResultType == 0\n| summarize SuccessfulSignins = count()",
              "size": 4,
              "title": "Successful Sign-ins",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "SuccessfulSignins",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "SuccessfulSignins",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                }
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "successful-signins"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where ResultType != 0\n| summarize FailedSignins = count()",
              "size": 4,
              "title": "Failed Sign-ins",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "FailedSignins",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "FailedSignins",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                }
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "failed-signins"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| extend CAStatus = iff(ConditionalAccessStatus == \"success\", \"Protected\", \"Unprotected\")\n| where CAStatus == \"Unprotected\"\n| summarize UnprotectedApps = dcount(AppDisplayName)",
              "size": 4,
              "title": "Apps Without CA Protection",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": true,
                "titleContent": {
                  "columnMatch": "UnprotectedApps",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "UnprotectedApps",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                }
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "unprotected-apps"
          }
        ]
      },
      "name": "executive-summary"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 2 – Application Access Matrix",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| extend CAStatus = iff(ConditionalAccessStatus == \"success\", \"Protected\", \"Unprotected\")\n| extend MFAUsed = iff(column_ifexists('AuthenticationRequirement', '') == 'MFA', 1, 0)\n| summarize\n    Users = dcount(UserPrincipalName),\n    Success = countif(ResultType == 0),\n    Failed = countif(ResultType != 0),\n    MFAPercent = round(sum(MFAUsed) * 100.0 / count(), 1)\n    by AppDisplayName, CAStatus\n| order by Success desc",
              "size": 0,
              "title": "Application Access Matrix",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "CAStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": "==",
                          "thresholdValue": "Protected",
                          "representation": "2",
                          "text": "Protected"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Unprotected",
                          "representation": "4",
                          "text": "Unprotected"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Failed",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": ">",
                          "thresholdValue": "5",
                          "representation": "4",
                          "text": "High"
                        },
                        {
                          "operator": "default",
                          "thresholdValue": null,
                          "representation": "2",
                          "text": "Low"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 100
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "app-access-matrix"
          }
        ]
      },
      "name": "app-access-matrix-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 3 – Applications Without Protection (Risk View)",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where ConditionalAccessStatus != \"success\"\n| project\n    TimeGenerated,\n    Application = AppDisplayName,\n    User = UserPrincipalName,\n    IPAddress,\n    Location = column_ifexists('Location', 'N/A'),\n    AuthMethod = column_ifexists('AuthenticationMethodsUsed', 'Unknown'),\n    Result = iff(ResultType == 0, \"Success\", \"Failed\")\n| order by TimeGenerated desc",
              "size": 0,
              "title": "Unprotected Application Access (High Risk)",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Result",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": "==",
                          "thresholdValue": "Failed",
                          "representation": "4",
                          "text": "Failed"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Success",
                          "representation": "2",
                          "text": "Success"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 500
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "unprotected-apps-risk"
          }
        ]
      },
      "name": "unprotected-apps-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 4 – User Investigation",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where UserPrincipalName == \"{User}\" or \"{User}\" == \"All\"\n| summarize\n    SigninCount = count(),\n    UniqueApps = dcount(AppDisplayName),\n    UniqueIPs = dcount(IPAddress),\n    FailureCount = countif(ResultType != 0),\n    LastSignin = max(TimeGenerated)\n    by UserPrincipalName\n| order by SigninCount desc",
              "size": 0,
              "title": "User Sign-in Summary",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "user-summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where UserPrincipalName == \"{User}\" or \"{User}\" == \"All\"\n| project\n    TimeGenerated,\n    Application = AppDisplayName,\n    Result = iff(ResultType == 0, \"Success\", \"Failed\"),\n    IPAddress,\n    Device = tostring(column_ifexists('DeviceDetail', dynamic({})).displayName),\n    Location = column_ifexists('Location', 'N/A'),\n    AuthMethod = column_ifexists('AuthenticationMethodsUsed', 'Unknown')\n| order by TimeGenerated desc",
              "size": 0,
              "title": "Recent Sign-ins",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Result",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": "==",
                          "thresholdValue": "Failed",
                          "representation": "4"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Success",
                          "representation": "2"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 100
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "user-detail-signins"
          }
        ]
      },
      "name": "user-investigation"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 5 – Authentication Analysis",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| extend MFARequired = column_ifexists('AuthenticationRequirement', 'Unknown')\n| summarize Count = count() by MFARequired\n| order by Count desc",
              "size": 0,
              "title": "MFA vs Non-MFA Sign-ins",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "mfa-analysis"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| mv-expand AuthenticationDetailsArray = parse_json(column_ifexists('AuthenticationDetails', '[]'))\n| extend AuthMethod = tostring(AuthenticationDetailsArray.authenticationMethod)\n| where isnotempty(AuthMethod)\n| summarize Count = count() by AuthMethod\n| order by Count desc",
              "size": 0,
              "title": "Authentication Methods Used",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "auth-methods"
          }
        ]
      },
      "name": "authentication-analysis"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 6 – Conditional Access Coverage",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| summarize\n    Protected = countif(ConditionalAccessStatus == \"success\"),\n    Unprotected = countif(ConditionalAccessStatus != \"success\")\n| extend Total = Protected + Unprotected\n| extend ProtectionPercent = round(Protected * 100.0 / Total, 1)",
              "size": 0,
              "title": "Conditional Access Coverage",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ProtectionPercent",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": ">=",
                          "thresholdValue": "90",
                          "representation": "2",
                          "text": "Good"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "70",
                          "representation": "1",
                          "text": "Fair"
                        },
                        {
                          "operator": "<",
                          "thresholdValue": "70",
                          "representation": "4",
                          "text": "Poor"
                        }
                      ]
                    }
                  }
                ]
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "ca-coverage"
          }
        ]
      },
      "name": "ca-coverage-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 7 – User Activity Timeline",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| project\n    TimeGenerated,\n    User = UserPrincipalName,\n    Application = AppDisplayName,\n    Result = iff(ResultType == 0, \"Success\", \"Failed\"),\n    IPAddress,\n    Description = ResultDescription\n| order by TimeGenerated desc\n| limit 1000",
              "size": 0,
              "title": "Sign-in Activity Timeline",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Result",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": "==",
                          "thresholdValue": "Failed",
                          "representation": "4"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Success",
                          "representation": "2"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 1000
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "timeline"
          }
        ]
      },
      "name": "timeline-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 8 – Geographic Access Map",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| summarize\n    Count = count(),\n    Users = dcount(UserPrincipalName),\n    Failures = countif(ResultType != 0)\n    by Location",
              "size": 0,
              "title": "Sign-in Activity by Location",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Failures",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": ">",
                          "thresholdValue": "10",
                          "representation": "4"
                        },
                        {
                          "operator": "default",
                          "thresholdValue": null,
                          "representation": "2"
                        }
                      ]
                    }
                  }
                ],
                "rowLimit": 100
              },
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "geo-map"
          }
        ]
      },
      "name": "geographic-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 9 – Risk Correlation",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| extend RiskLevel = case(\n    ResultType != 0, \"High\",\n    ConditionalAccessStatus != \"success\", \"Medium\",\n    \"Low\")\n| summarize\n    Count = count(),\n    UniqueUsers = dcount(UserPrincipalName),\n    FailureRate = round(countif(ResultType != 0) * 100.0 / count(), 1)\n    by RiskLevel\n| order by Count desc",
              "size": 0,
              "title": "Risk Distribution",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "risk-distribution"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where ResultType != 0\n| summarize\n    FailureCount = count(),\n    UniqueUsers = dcount(UserPrincipalName),\n    UniqueApps = dcount(AppDisplayName)\n    by ResultType, ResultDescription\n| order by FailureCount desc",
              "size": 0,
              "title": "Failed Sign-in Root Causes",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "crossComponentResources": [
                "{Workspace}"
              ]
            },
            "name": "failure-analysis"
          }
        ]
      },
      "name": "risk-section"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Section 10 – Application Deep Dive",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SigninLogs\n| where AppDisplayName == \"{Application}\" or \"{Application}\" == \"All\"\n| summarize\n    TotalSignins = count(),\n    UniqueUsers = dcount(UserPrincipalName),\n    SuccessCount = countif(ResultType == 0),\n    FailureCount = countif(ResultType != 0),\n    ProtectedCount = countif(ConditionalAccessStatus == \"success\")\n    by AppDisplayName\n| extend SuccessRate = round(SuccessCount * 100.0 / TotalSignins, 1)\n| extend ProtectionRate = round(ProtectedCount * 100.0 / TotalSignins, 1)",
              "size": 0,
              "title": "Application Overview",
              "timeContext": {
                "durationMs": 0
              },
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "SuccessRate",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsStyle": "icons",
                      "thresholds": [
                        {
                          "operator": ">=",
                          "thresholdValue": "95",
                          "representation": "2"
                        },
                        {
                          "operator": ">=",
                          "thresholdValue": "80",
                          "representation": "1"
                        },
                        {
                          "operator": "<",
                          "thresholdValue": "80",
                          "representation": "4"
                        }
                      ]
                    }
